---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getLocaleFromPathname } from '../i18n/config';
import { getTranslations } from '../i18n/translations';

const locale = getLocaleFromPathname(Astro.url.pathname);
const t = getTranslations(locale);
const homeHref = locale === 'en' ? '/en/' : '/';
const projectsHref = `${homeHref}#projects`;
---

<BaseLayout
  locale={locale}
  title={`404 · ${t.notFound.title}`}
  description={t.notFound.description}
>
  <Header locale={locale} />

  <main class="min-h-screen flex items-center bg-neutral-50 dark:bg-neutral-950 pt-24">
    <section class="container-custom py-20 md:py-24">
      <div class="panel p-8 md:p-10 max-w-2xl mx-auto text-center" data-reveal-item>
        <p class="kicker mb-3">Error 404</p>
        <h1 class="heading-2 mb-4">{t.notFound.title}</h1>
        <p class="text-body mx-auto mb-8">{t.notFound.description}</p>

        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href={homeHref} class="inline-flex items-center justify-center rounded-lg bg-primary-600 text-white px-5 py-2.5 text-sm font-medium hover:bg-primary-700 transition-colors duration-200">
            {t.notFound.backHome}
          </a>
          <a href={projectsHref} class="inline-flex items-center justify-center rounded-lg border border-neutral-300 dark:border-neutral-700 px-5 py-2.5 text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors duration-200">
            {t.notFound.viewProjects}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>
