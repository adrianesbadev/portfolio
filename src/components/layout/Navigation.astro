---
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = getTranslations(locale);

const navItems = [
  { label: t.nav.home, href: '#home' },
  { label: t.nav.projects, href: '#projects' },
  { label: t.nav.about, href: '#about' },
  { label: t.nav.experience, href: '#experience' },
  { label: t.nav.contact, href: '#contact' },
];
---

<nav class="navigation" aria-label="Primary navigation">
  <ul class="flex flex-col md:flex-row gap-4 md:gap-6">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class="nav-link text-sm md:text-[0.95rem] text-neutral-600 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white transition-colors"
          data-nav-link
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
