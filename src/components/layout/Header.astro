---
import Navigation from './Navigation.astro';
import Button from '../ui/Button.astro';
import GlobalPreferences from '../ui/GlobalPreferences.astro';
import { getPersonalInfo } from '../../data/personal';
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = getTranslations(locale);
const personalInfo = getPersonalInfo(locale);
---

<header class="fixed top-0 left-0 right-0 z-50 transition-colors duration-200" id="header">
  <div class="container-custom py-4">
    <div class="header-shell flex items-center justify-between gap-4 rounded-xl border border-neutral-200/90 dark:border-neutral-800/90 bg-white/90 dark:bg-neutral-950/90 backdrop-blur px-4 md:px-5 py-3">
      <a href="#home" class="flex items-center gap-3" aria-label="Go to top">
        <span class="inline-flex w-8 h-8 rounded-md bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 items-center justify-center text-xs font-semibold">
          AE
        </span>
        <span class="leading-tight">
          <span class="block text-sm font-semibold text-neutral-950 dark:text-neutral-100">{personalInfo.fullName}</span>
          <span class="block text-xs text-neutral-500 dark:text-neutral-400">{t.header.brandSubtitle}</span>
        </span>
      </a>

      <nav class="hidden md:block" aria-label="Navegación principal">
        <Navigation locale={locale} />
      </nav>

      <div class="hidden md:flex items-center gap-2">
        <GlobalPreferences locale={locale} />
        <Button href="#contact" variant="primary" size="sm">{t.header.cta}</Button>
      </div>

      <button
        id="mobile-menu-button"
        class="md:hidden p-2 text-neutral-700 dark:text-neutral-300"
        aria-label={t.header.mobileMenuOpenLabel}
        aria-expanded="false"
        type="button"
        data-open-label={t.header.mobileMenuOpenLabel}
        data-close-label={t.header.mobileMenuCloseLabel}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="md:hidden hidden mt-2 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 px-4 py-4">
      <Navigation locale={locale} />

      <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800 mt-4 space-y-4">
        <GlobalPreferences locale={locale} mobile />
        <Button href="#contact" variant="primary" size="sm" class="w-full">{t.header.cta}</Button>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  let isOpen = false;

  if (mobileMenuButton && mobileMenu) {
    const openLabel = mobileMenuButton.getAttribute('data-open-label') || 'Open menu';
    const closeLabel = mobileMenuButton.getAttribute('data-close-label') || 'Close menu';

    const updateMobileState = () => {
      mobileMenu.classList.toggle('hidden', !isOpen);
      mobileMenuButton.setAttribute('aria-expanded', String(isOpen));
      mobileMenuButton.setAttribute('aria-label', isOpen ? closeLabel : openLabel);
    };

    mobileMenuButton.addEventListener('click', () => {
      isOpen = !isOpen;
      updateMobileState();
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        isOpen = false;
        updateMobileState();
      });
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        isOpen = false;
        updateMobileState();
      }
    });
  }

  const navLinks = Array.from(document.querySelectorAll('[data-nav-link]'));
  const sectionIds = navLinks
    .map((link) => link.getAttribute('href'))
    .filter((href) => href && href.startsWith('#'))
    .map((href) => href?.replace('#', ''));

  const sections = sectionIds
    .map((id) => document.getElementById(id || ''))
    .filter(Boolean);

  const setActiveNavLink = (id) => {
    navLinks.forEach((link) => {
      const href = link.getAttribute('href') || '';
      link.classList.toggle('is-active', href === `#${id}`);
    });
  };

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target.id) {
            setActiveNavLink(entry.target.id);
          }
        });
      },
      {
        rootMargin: '-35% 0px -55% 0px',
        threshold: 0,
      }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
