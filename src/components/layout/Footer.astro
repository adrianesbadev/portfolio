---
import { getPersonalInfo } from '../../data/personal';
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const personalInfo = getPersonalInfo(locale);
const t = getTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-50 dark:bg-neutral-950 border-t border-neutral-200 dark:border-neutral-800 transition-colors duration-300">
  <div class="container-custom py-10 md:py-12">
    <div class="grid md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] gap-6 items-start">
      <div>
        <p class="text-sm uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400 mb-2">{t.footer.sectionLabel}</p>
        <p class="text-neutral-900 dark:text-neutral-100 font-medium max-w-xl">
          {personalInfo.fullName} · {t.footer.statement}
        </p>
      </div>

      <div class="md:text-right">
        <div class="flex md:justify-end gap-5 text-sm mb-3">
          <a href={personalInfo.social.github} target="_blank" rel="noopener noreferrer" class="text-neutral-600 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-300">GitHub</a>
          <a href={personalInfo.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-neutral-600 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-300">{t.footer.linkedinLabel}</a>
          <a href={`mailto:${personalInfo.email}`} class="text-neutral-600 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-300">Email</a>
        </div>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">© {currentYear} {personalInfo.fullName}</p>
      </div>
    </div>
  </div>
</footer>
