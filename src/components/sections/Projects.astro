---
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';
import { getFeaturedProjects, getProjects } from '../../data/projects';
import ProjectCard from '../ui/ProjectCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = getTranslations(locale);
const featuredProjects = getFeaturedProjects(locale);
const projects = getProjects(locale);
const selectedProjects = featuredProjects.length > 0 ? featuredProjects : projects;
---

<section id="projects" class="section bg-white dark:bg-neutral-900 transition-colors duration-300" data-section>
  <div class="container-custom">
    <div class="max-w-3xl mb-10 md:mb-12" data-reveal-item>
      <p class="kicker mb-3">{t.projects.kicker}</p>
      <h2 class="heading-2 mb-4">{t.projects.title}</h2>
      <p class="text-body">{t.projects.intro}</p>
    </div>

    <div class="space-y-8" data-stagger-container>
      {selectedProjects.map((project, index) => (
        <ProjectCard project={project} index={index} locale={locale} />
      ))}
    </div>
  </div>
</section>
