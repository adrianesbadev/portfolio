---
import { personalInfo } from '../../data/personal';
import Button from '../ui/Button.astro';
---

<section
  id="home"
  class="min-h-screen flex items-center justify-center pt-20 md:pt-24 bg-gradient-to-b from-white dark:from-neutral-900 to-neutral-50 dark:to-neutral-950 relative overflow-hidden transition-colors duration-300"
>
  <!-- Elementos decorativos con parallax mejorado -->
  <div 
    class="absolute inset-0 opacity-10 pointer-events-none overflow-hidden"
  >
    <div 
      class="absolute top-20 left-10 w-72 h-72 bg-primary-500 rounded-full blur-3xl animate-pulse"
      data-parallax="0.4"
      data-parallax-direction="y"
    ></div>
    <div 
      class="absolute bottom-20 right-10 w-96 h-96 bg-accent-400 rounded-full blur-3xl animate-pulse"
      data-parallax="0.3"
      data-parallax-direction="y"
      style="animation-delay: 1s;"
    ></div>
    <div 
      class="absolute top-1/2 left-1/2 w-64 h-64 bg-primary-300 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"
      data-parallax="0.2"
      data-parallax-direction="y"
      style="animation-delay: 0.5s;"
    ></div>
  </div>
  <div class="container-custom">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge de disponibilidad -->
      {personalInfo.availableForWork && (
        <div class="hero-badge inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-primary-50 to-accent-50 text-primary-700 rounded-full text-sm font-medium mb-8 border border-primary-200/50 shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
          </span>
          Disponible para trabajar
        </div>
      )}

      <!-- Nombre principal con animación typewriter -->
      <h1 
        class="hero-title heading-1 mb-6" 
        id="hero-name"
        data-name={personalInfo.fullName || personalInfo.name}
      >
        <span class="gradient-text typewriter-text"></span>
      </h1>

      <!-- Rol -->
      <p class="hero-role text-body-lg text-neutral-700 dark:text-neutral-300 mb-8 max-w-2xl mx-auto">
        {personalInfo.role}
      </p>

      <!-- Descripción breve -->
      <p class="hero-bio text-body mb-12 max-w-2xl mx-auto">
        {personalInfo.bio}
      </p>

      <!-- CTAs -->
      <div class="hero-cta flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="#projects" variant="primary" size="lg">
          Ver Proyectos
        </Button>
        <Button href="#contact" variant="outline" size="lg">
          Contactar
        </Button>
      </div>

      <!-- Scroll indicator (opcional) -->
      <div class="hero-scroll mt-16">
        <a
          href="#projects"
          class="inline-flex flex-col items-center gap-2 text-neutral-400 dark:text-neutral-500 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200 animate-bounce"
          aria-label="Scroll hacia abajo"
        >
          <span class="text-xs font-medium">Explorar</span>
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
