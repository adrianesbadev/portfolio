---
import { getPersonalInfo } from '../../data/personal';
import { getProjects } from '../../data/projects';
import { getExperiences } from '../../data/experience';
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;

const personalInfo = getPersonalInfo(locale);
const projects = getProjects(locale);
const experiences = getExperiences(locale);
const t = getTranslations(locale);

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const profilePhotoPath = `${baseUrl}profile/adrian-esquivel.jpg`;
const fallbackPhotoPath = `${baseUrl}profile/avatar-placeholder.svg`;

const quickStats = [
  { label: t.hero.statProjects, value: String(projects.length).padStart(2, '0') },
  { label: t.hero.statExperience, value: String(experiences.length).padStart(2, '0') },
  { label: t.hero.statResponse, value: personalInfo.responseTime },
];
---

<section id="home" class="section pt-32 md:pt-36 bg-neutral-50 dark:bg-neutral-950 transition-colors duration-300" data-section>
  <div class="container-custom">
    <div class="grid lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.9fr)] gap-10 items-start">
      <div>
        <p class="kicker mb-4" data-reveal-item>{t.hero.kicker}</p>

        <h1 class="heading-1 max-w-4xl mb-5" data-reveal-item>{personalInfo.headline}</h1>

        <p class="text-body-lg mb-8" data-reveal-item>{personalInfo.subheadline}</p>

        <div class="grid sm:grid-cols-3 gap-3 mb-8" data-reveal-item>
          {quickStats.map((item) => (
            <div class="panel-muted">
              <p class="text-xs uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400">{item.label}</p>
              <p class="text-lg font-semibold text-neutral-950 dark:text-neutral-100 mt-1">{item.value}</p>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row items-start gap-3" data-reveal-item>
          <Button href="#projects" variant="primary" size="lg">{t.hero.primaryCta}</Button>
          <Button href="#contact" variant="outline" size="lg">{t.hero.secondaryCta}</Button>
        </div>
      </div>

      <aside data-reveal-item>
        <div class="panel overflow-hidden">
          <img
            src={profilePhotoPath}
            alt={`Portrait of ${personalInfo.fullName}`}
            class="w-full aspect-[4/5] object-cover"
            loading="eager"
            onerror={`this.onerror=null;this.src='${fallbackPhotoPath}'`}
          />

          <div class="p-5 border-t border-neutral-200 dark:border-neutral-800">
            <p class="font-semibold text-neutral-950 dark:text-neutral-100">{personalInfo.fullName}</p>
            <p class="text-sm text-primary-700 dark:text-primary-300 mt-1">{personalInfo.role}</p>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-3">{personalInfo.location}</p>

            <ul class="mt-4 space-y-2">
              {t.hero.focusItems.map((item) => (
                <li class="text-sm text-neutral-700 dark:text-neutral-300">{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
