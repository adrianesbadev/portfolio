---
import FormInput from '../ui/FormInput.astro';
import Button from '../ui/Button.astro';
import { getPersonalInfo } from '../../data/personal';
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const personalInfo = getPersonalInfo(locale);
const t = getTranslations(locale);

const emailjsConfig = {
  publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY || 'YOUR_PUBLIC_KEY',
  serviceId: import.meta.env.PUBLIC_EMAILJS_SERVICE_ID || 'YOUR_SERVICE_ID',
  templateId: import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID || 'YOUR_TEMPLATE_ID',
};

const contextLead = t.contact.contextLead.replace('{responseTime}', personalInfo.responseTime);
---

<script>
  (function loadEmailJS() {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
    script.async = true;
    script.onload = function () {
      window.emailjsLoaded = true;
      window.dispatchEvent(new Event('emailjsReady'));
    };
    script.onerror = function () {
      window.emailjsLoaded = false;
    };
    document.head.appendChild(script);
  })();
</script>

<section id="contact" class="section bg-neutral-50 dark:bg-neutral-950 transition-colors duration-300" data-section>
  <div class="container-custom">
    <div class="max-w-3xl mb-10 md:mb-12" data-reveal-item>
      <p class="kicker mb-3">{t.contact.kicker}</p>
      <h2 class="heading-2 mb-4">{t.contact.title}</h2>
      <p class="text-body">{t.contact.intro}</p>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-6 md:gap-8">
      <aside class="panel h-fit p-5 md:p-6" data-reveal-item>
        <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed mb-4">{contextLead}</p>

        <ul class="case-list space-y-2 text-sm text-neutral-700 dark:text-neutral-300 mb-5">
          {t.contact.collaborationModes.map((mode) => (
            <li>{mode}</li>
          ))}
        </ul>

        <div class="space-y-2 text-sm">
          <p>
            <span class="text-neutral-500 dark:text-neutral-400">{t.contact.emailLabel}:</span>
            <a href={`mailto:${personalInfo.email}`} class="text-primary-700 dark:text-primary-300 hover:underline ml-2">
              {personalInfo.email}
            </a>
          </p>
          <p>
            <span class="text-neutral-500 dark:text-neutral-400">{t.contact.linkedinLabel}:</span>
            <a href={personalInfo.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-primary-700 dark:text-primary-300 hover:underline ml-2">
              {t.contact.linkedinCta}
            </a>
          </p>
        </div>
      </aside>

      <form id="contact-form" class="panel p-5 md:p-6 space-y-5" novalidate data-reveal-item>
        <FormInput
          id="name"
          name="name"
          type="text"
          label={t.contact.form.nameLabel}
          required
          placeholder={t.contact.form.namePlaceholder}
        />

        <FormInput
          id="email"
          name="email"
          type="email"
          label={t.contact.form.emailLabel}
          required
          placeholder={t.contact.form.emailPlaceholder}
        />

        <FormInput
          id="message"
          name="message"
          type="textarea"
          label={t.contact.form.messageLabel}
          required
          placeholder={t.contact.form.messagePlaceholder}
          rows={6}
        />

        <div class="pt-2">
          <Button type="submit" variant="primary" size="md" class="w-full sm:w-auto relative" id="submit-btn">
            <span id="submit-text">{t.contact.form.submitIdle}</span>
            <span id="submit-loader" class="hidden">
              <svg class="animate-spin -ml-1 mr-3 h-4 w-4 inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              {t.contact.form.submitLoading}
            </span>
          </Button>
        </div>

        <div
          id="success-message"
          class="hidden p-3 rounded-lg border border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-300"
          role="alert"
        >
          <p class="font-medium text-sm">{t.contact.form.success}</p>
        </div>

        <div
          id="error-message"
          class="hidden p-3 rounded-lg border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-300"
          role="alert"
        >
          <p class="font-medium text-sm" id="error-text">{t.contact.form.errorDefault}</p>
        </div>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ emailjsConfig, contactEmail: personalInfo.email, copy: t.contact }}>
  const EMAILJS_CONFIG = emailjsConfig;
  const CONTACT_EMAIL = contactEmail;
  const CONTACT_COPY = copy;

  function initContactForm() {
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const submitText = document.getElementById('submit-text');
    const submitLoader = document.getElementById('submit-loader');
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');

    if (!form || !submitBtn || !submitText || !submitLoader || !successMessage || !errorMessage || !errorText) {
      return;
    }

    function setLoading(isLoading) {
      if (isLoading) {
        submitBtn.disabled = true;
        submitText.classList.add('hidden');
        submitLoader.classList.remove('hidden');
      } else {
        submitBtn.disabled = false;
        submitText.classList.remove('hidden');
        submitLoader.classList.add('hidden');
      }
    }

    function hideMessages() {
      successMessage.classList.add('hidden');
      errorMessage.classList.add('hidden');
    }

    function showError(message) {
      errorText.textContent = message;
      errorMessage.classList.remove('hidden');
    }

    async function waitForEmailJS() {
      return new Promise((resolve, reject) => {
        if (typeof window.emailjs !== 'undefined' && window.emailjsLoaded) {
          resolve(window.emailjs);
          return;
        }

        const timeout = setTimeout(() => reject(new Error(CONTACT_COPY.validation.emailJsLoadError)), 10000);

        window.addEventListener(
          'emailjsReady',
          () => {
            clearTimeout(timeout);
            if (typeof window.emailjs !== 'undefined') {
              resolve(window.emailjs);
            } else {
              reject(new Error(CONTACT_COPY.validation.emailJsUnavailable));
            }
          },
          { once: true }
        );
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      hideMessages();

      const formData = new FormData(form);
      const name = String(formData.get('name') || '').trim();
      const email = String(formData.get('email') || '').trim();
      const message = String(formData.get('message') || '').trim();

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (name.length < 2) {
        showError(CONTACT_COPY.validation.nameMin);
        return;
      }

      if (!emailRegex.test(email)) {
        showError(CONTACT_COPY.validation.emailInvalid);
        return;
      }

      if (message.length < 10) {
        showError(CONTACT_COPY.validation.messageMin);
        return;
      }

      if (
        EMAILJS_CONFIG.publicKey === 'YOUR_PUBLIC_KEY' ||
        EMAILJS_CONFIG.serviceId === 'YOUR_SERVICE_ID' ||
        EMAILJS_CONFIG.templateId === 'YOUR_TEMPLATE_ID'
      ) {
        showError(CONTACT_COPY.validation.emailJsMissing);
        return;
      }

      try {
        setLoading(true);

        const emailjsLib = await waitForEmailJS();
        emailjsLib.init(EMAILJS_CONFIG.publicKey);

        await emailjsLib.send(EMAILJS_CONFIG.serviceId, EMAILJS_CONFIG.templateId, {
          from_name: name,
          from_email: email,
          message,
          to_name: 'Adrián',
        });

        successMessage.classList.remove('hidden');
        form.reset();
      } catch (error) {
        const fallbackText = CONTACT_COPY.validation.sendFallback.replace('{contactEmail}', CONTACT_EMAIL);
        const message = error instanceof Error ? `${error.message} ${fallbackText}` : fallbackText;
        showError(message);
      } finally {
        setLoading(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>
