---
import { personalInfo } from '../../data/personal';
import { skillsByCategory } from '../../data/skills';
import SkillBadge from '../ui/SkillBadge.astro';

const categoryLabels = {
  backend: 'Backend',
  frontend: 'Frontend',
  database: 'Base de Datos',
  tools: 'Herramientas',
  other: 'Otros',
};
---

<section id="about" class="section bg-neutral-50 dark:bg-neutral-950 transition-colors duration-300" data-section-reveal>
  <div class="container-custom">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 
        class="heading-2 mb-4" 
        data-reveal-item
        data-text-split
      >
        Sobre mí
      </h2>
      <p 
        class="text-body max-w-2xl mx-auto" 
        data-reveal-item
      >
        {personalInfo.bio}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12 md:gap-16">
      <!-- Skills por categoría -->
      <div data-reveal-item>
        <h3 class="heading-3 mb-6">Tecnologías</h3>
        <div class="space-y-8">
          {Object.entries(skillsByCategory).map(([category, categorySkills]) => {
            if (categorySkills.length === 0) return null;
            return (
              <div>
                <h4 class="text-lg font-semibold text-neutral-900 dark:text-neutral-50 mb-3">
                  {categoryLabels[category as keyof typeof categoryLabels] || category}
                </h4>
                <div class="flex flex-wrap gap-2">
                  {categorySkills.map((skill) => (
                    <SkillBadge name={skill.name} category={category} />
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Timeline / Educación -->
      <div data-reveal-item>
        <h3 class="heading-3 mb-6">Formación</h3>
        <div class="space-y-6">
          <!-- Timeline item -->
          <div class="relative pl-8 pb-8 border-l-2 border-primary-200 dark:border-primary-800">
            <div class="absolute -left-2 top-0 w-4 h-4 bg-primary-600 dark:bg-primary-500 rounded-full"></div>
            <div class="space-y-1">
              <h4 class="text-lg font-semibold text-neutral-900 dark:text-neutral-50">
                CFGS Desarrollo de Aplicaciones Multiplataforma
              </h4>
              <p class="text-neutral-600 dark:text-neutral-400 text-sm">
                {personalInfo.graduationDate}
              </p>
              <p class="text-neutral-600 dark:text-neutral-400 text-sm">
                España
              </p>
              <p class="text-neutral-600 dark:text-neutral-400 mt-2">
                Formación en desarrollo de aplicaciones web y móviles, con enfoque en tecnologías modernas y mejores prácticas.
              </p>
            </div>
          </div>

          <!-- Timeline item adicional (puedes añadir más) -->
          <div class="relative pl-8 pb-8 border-l-2 border-primary-200 dark:border-primary-800">
            <div class="absolute -left-2 top-0 w-4 h-4 bg-primary-600 dark:bg-primary-500 rounded-full"></div>
            <div class="space-y-1">
              <h4 class="text-lg font-semibold text-neutral-900 dark:text-neutral-50">
                Desarrollo Web Autodidacta
              </h4>
              <p class="text-neutral-600 dark:text-neutral-400 text-sm">
                2023 - Presente
              </p>
              <p class="text-neutral-600 dark:text-neutral-400 mt-2">
                Aprendizaje continuo de tecnologías web modernas, frameworks y herramientas de desarrollo.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Información adicional -->
    <div class="mt-12 md:mt-16 pt-12 border-t border-neutral-200 dark:border-neutral-800">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div data-reveal-item>
          <div 
            class="text-3xl md:text-4xl font-bold text-primary-600 mb-2"
            data-counter={new Date().getFullYear() - 2023}
            data-counter-duration="2"
            data-counter-suffix="+"
          >
            0+
          </div>
          <p class="text-neutral-600 dark:text-neutral-400">Años de experiencia</p>
        </div>
        <div data-reveal-item>
          <div class="text-3xl md:text-4xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            {personalInfo.graduationDate.split(' ')[1]}
          </div>
          <p class="text-neutral-600 dark:text-neutral-400">Graduación prevista</p>
        </div>
        <div data-reveal-item>
          <div class="text-3xl md:text-4xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            {personalInfo.location}
          </div>
          <p class="text-neutral-600 dark:text-neutral-400">Ubicación</p>
        </div>
      </div>
    </div>
  </div>
</section>
