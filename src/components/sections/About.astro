---
import { getPersonalInfo } from '../../data/personal';
import { skills } from '../../data/skills';
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const personalInfo = getPersonalInfo(locale);
const t = getTranslations(locale);

const coreSkillNames = ['Java', 'Spring Boot', 'TypeScript', 'JavaScript', 'React', 'Astro', 'MySQL', 'Git'];
const workingSkillNames = ['Node.js', 'Docker', 'PostgreSQL', 'Tailwind CSS'];

const coreSkills = skills.filter((skill) => coreSkillNames.includes(skill.name));
const workingSkills = skills.filter((skill) => workingSkillNames.includes(skill.name));
---

<section id="about" class="section bg-neutral-50 dark:bg-neutral-950 transition-colors duration-300" data-section>
  <div class="container-custom">
    <div class="max-w-3xl mb-10 md:mb-12" data-reveal-item>
      <p class="kicker mb-3">{t.about.kicker}</p>
      <h2 class="heading-2 mb-4">{t.about.title}</h2>
      <p class="text-body">{personalInfo.bio}</p>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.95fr)] gap-6 md:gap-8">
      <div class="space-y-4" data-reveal-item>
        {t.about.principles.map((item) => (
          <article class="panel-muted">
            <h3 class="text-lg font-semibold text-neutral-950 dark:text-neutral-100 mb-1">{item.title}</h3>
            <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>

      <div class="space-y-5" data-reveal-item>
        <article class="panel p-5">
          <p class="text-xs uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400 mb-3">{t.about.contributionTitle}</p>
          <ul class="case-list space-y-2 text-sm text-neutral-700 dark:text-neutral-300">
            {t.about.contributionAreas.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>

        <article class="panel p-5">
          <p class="text-xs uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400 mb-3">{t.about.coreStackTitle}</p>
          <div class="flex flex-wrap gap-2">
            {coreSkills.map((skill) => (
              <span class="tag-core">{skill.name}</span>
            ))}
          </div>

          <p class="text-xs uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400 mt-5 mb-3">{t.about.secondaryStackTitle}</p>
          <div class="flex flex-wrap gap-2">
            {workingSkills.map((skill) => (
              <span class="tag-subtle">{skill.name}</span>
            ))}
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
