---
import { getExperiences } from '../../data/experience';
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const experiences = getExperiences(locale);
const t = getTranslations(locale);
---

<section id="experience" class="section bg-white dark:bg-neutral-900 transition-colors duration-300" data-section>
  <div class="container-custom">
    <div class="max-w-3xl mb-10 md:mb-12" data-reveal-item>
      <p class="kicker mb-3">{t.experience.kicker}</p>
      <h2 class="heading-2 mb-4">{t.experience.title}</h2>
      <p class="text-body">{t.experience.intro}</p>
    </div>

    <div class="space-y-6" data-stagger-container>
      {experiences.map((exp) => (
        <article class="panel p-5 md:p-6" data-stagger-item>
          <header class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 mb-4">
            <div>
              <h3 class="text-xl md:text-2xl font-semibold text-neutral-950 dark:text-neutral-100">{exp.position}</h3>
              <p class="text-primary-700 dark:text-primary-300 font-medium mt-1">{exp.company}</p>
            </div>

            <div class="text-sm text-neutral-600 dark:text-neutral-400 md:text-right">
              <p>{exp.startDate} - {exp.endDate || t.experience.present}</p>
              {exp.location && <p>{exp.location}</p>}
            </div>
          </header>

          <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed mb-4">{exp.summary}</p>

          <ul class="case-list space-y-2 text-sm text-neutral-700 dark:text-neutral-300 mb-4">
            {exp.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="rounded-lg border border-primary-200 dark:border-primary-800 bg-primary-50/60 dark:bg-primary-900/20 p-4 mb-4">
            <p class="text-xs uppercase tracking-[0.08em] text-primary-700 dark:text-primary-300 mb-1">{t.experience.impact}</p>
            <p class="text-sm text-neutral-800 dark:text-neutral-200 leading-relaxed">{exp.impact}</p>
          </div>

          <div class="flex flex-wrap gap-2">
            {exp.technologies.map((tech) => (
              <span class="tag-subtle">{tech}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
