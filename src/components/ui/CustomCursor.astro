---
// Cursor personalizado moderno y elegante con efectos de magnetismo
// Solo se muestra en desktop, no en móvil
---

<div id="custom-cursor" class="custom-cursor">
  <div class="cursor-dot"></div>
  <div class="cursor-outline"></div>
  <div class="cursor-ripple"></div>
</div>

<style>
  /* Cursor personalizado - solo desktop */
  @media (min-width: 1024px) and (pointer: fine) {
    /* Ocultar cursor nativo globalmente - DEBE IR PRIMERO */
    html,
    body,
    *,
    *::before,
    *::after {
      cursor: none !important;
    }

    /* Mantener cursor en inputs y textareas para accesibilidad */
    input,
    textarea,
    [contenteditable] {
      cursor: text !important;
    }

    /* Asegurar que todos los elementos interactivos no muestren cursor */
    a,
    button,
    [role="button"],
    [href],
    [data-cursor-pointer],
    .project-item,
    .filter-btn,
    svg,
    img {
      cursor: none !important;
    }

    .custom-cursor {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 9999;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .custom-cursor.active {
      opacity: 1;
    }

    .cursor-dot {
      position: absolute;
      top: 0;
      left: 0;
      width: 8px;
      height: 8px;
      background: #a855f7;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  height 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  background 0.25s ease,
                  box-shadow 0.25s ease;
      box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.4);
      will-change: transform;
    }

    .cursor-outline {
      position: absolute;
      top: 0;
      left: 0;
      width: 40px;
      height: 40px;
      border: 2px solid rgba(147, 51, 234, 0.8);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                  height 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                  border-color 0.3s ease,
                  border-width 0.3s ease,
                  opacity 0.3s ease;
      opacity: 1;
      will-change: transform;
    }

    .cursor-ripple {
      position: absolute;
      top: 0;
      left: 0;
      width: 32px;
      height: 32px;
      border: 2px solid rgba(168, 85, 247, 0.3);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
      transition: transform 0.6s ease, opacity 0.6s ease;
    }

    /* Estados hover - elementos interactivos */
    .custom-cursor.hover .cursor-dot {
      width: 0px;
      height: 0px;
      background: white;
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
    }

    .custom-cursor.hover .cursor-outline {
      width: 50px;
      height: 50px;
      border-color: white;
      border-width: 2px;
      opacity: 1;
    }

    /* Estado click */
    .custom-cursor.click .cursor-dot {
      width: 4px;
      height: 4px;
      box-shadow: 0 0 0 8px rgba(168, 85, 247, 0.2);
    }

    .custom-cursor.click .cursor-outline {
      width: 28px;
      height: 28px;
      border-width: 2px;
    }

    .custom-cursor.click .cursor-ripple {
      transform: translate(-50%, -50%) scale(2);
      opacity: 0;
    }

    /* Efecto de magnetismo en botones */
    .custom-cursor.magnetic .cursor-outline {
      width: 60px;
      height: 60px;
      border-color: rgba(147, 51, 234, 0.8);
      border-width: 2px;
    }

  }

  /* En móvil, mantener cursor normal */
  @media (max-width: 1023px), (pointer: coarse) {
    .custom-cursor {
      display: none;
    }
  }
</style>

<script>
  // Inicializar cursor cuando el DOM esté listo
  function initCustomCursor() {
    // Solo ejecutar en desktop con mouse
    if (window.innerWidth < 1024 || !window.matchMedia('(pointer: fine)').matches) {
      return;
    }

    const cursor = document.getElementById('custom-cursor');
    const dot = cursor?.querySelector('.cursor-dot');
    const outline = cursor?.querySelector('.cursor-outline');
    const ripple = cursor?.querySelector('.cursor-ripple');

    if (!cursor || !dot || !outline) {
      if (import.meta.env.DEV) {
        console.warn('Custom cursor elements not found');
      }
      return;
    }

    let mouseX = 0;
    let mouseY = 0;
    let outlineX = 0;
    let outlineY = 0;
    let rafId = null;

    // Elementos interactivos que activan hover
    const interactiveElements = document.querySelectorAll(
      'a, button, [role="button"], [data-cursor-pointer], input, textarea, [data-card-animate], .project-item, .filter-btn, [data-stagger-item]'
    );

    // Elementos con efecto de magnetismo (botones principalmente)
    const magneticElements = document.querySelectorAll(
      'button, a[href^="#"], .filter-btn, [data-card-animate]'
    );

    // Inicializar posición del cursor en el centro
    mouseX = window.innerWidth / 2;
    mouseY = window.innerHeight / 2;
    outlineX = mouseX;
    outlineY = mouseY;

    // Posicionar elementos inicialmente
    dot.style.left = `${mouseX}px`;
    dot.style.top = `${mouseY}px`;
    outline.style.left = `${outlineX}px`;
    outline.style.top = `${outlineY}px`;

    // Mostrar cursor después de un pequeño delay
    setTimeout(() => {
      cursor.classList.add('active');
    }, 100);

    // Función de animación suave con lerp (interpolación)
    const lerp = (start, end, factor) => {
      return start + (end - start) * factor;
    };

    // Seguir mouse con efecto de magnetismo
    const updateCursor = () => {
      // Dot sigue directamente (sin delay)
      if (dot) {
        dot.style.left = `${mouseX}px`;
        dot.style.top = `${mouseY}px`;
      }

      // Outline sigue con delay suave (efecto magnetismo)
      outlineX = lerp(outlineX, mouseX, 0.15);
      outlineY = lerp(outlineY, mouseY, 0.15);

      if (outline) {
        outline.style.left = `${outlineX}px`;
        outline.style.top = `${outlineY}px`;
      }

      if (ripple) {
        ripple.style.left = `${mouseX}px`;
        ripple.style.top = `${mouseY}px`;
      }

      rafId = requestAnimationFrame(updateCursor);
    };

    updateCursor();

    // Trackear posición del mouse
    const handleMouseMove = (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      // Asegurar que el cursor esté visible cuando se mueve el mouse
      if (!cursor.classList.contains('active')) {
        cursor.classList.add('active');
      }
    };

    document.addEventListener('mousemove', handleMouseMove);
    
    // También activar en el primer movimiento del mouse
    document.addEventListener('mousemove', () => {
      cursor.classList.add('active');
    }, { once: true });

    // Efecto de magnetismo en botones
    magneticElements.forEach((element) => {
      const htmlElement = element;
      
      element.addEventListener('mouseenter', () => {
        cursor?.classList.add('magnetic');
        
        // Calcular posición del centro del elemento
        const rect = htmlElement.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        
        // Atraer cursor hacia el centro del elemento
        const attractCursor = () => {
          const dx = centerX - mouseX;
          const dy = centerY - mouseY;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance < 100) {
            const force = (100 - distance) / 100;
            mouseX += dx * force * 0.1;
            mouseY += dy * force * 0.1;
          }
        };
        
        const interval = setInterval(attractCursor, 16);
        
        element.addEventListener('mouseleave', () => {
          cursor?.classList.remove('magnetic');
          clearInterval(interval);
        }, { once: true });
      });
    });

    // Detectar hover en elementos interactivos
    interactiveElements.forEach((element) => {
      element.addEventListener('mouseenter', () => {
        cursor?.classList.add('hover');
      });

      element.addEventListener('mouseleave', () => {
        cursor?.classList.remove('hover');
      });
    });

    // Efecto de click con ripple
    document.addEventListener('mousedown', () => {
      cursor?.classList.add('click');
      if (ripple) {
        ripple.style.transform = 'translate(-50%, -50%) scale(0)';
        ripple.style.opacity = '0.6';
        setTimeout(() => {
          ripple.style.transform = 'translate(-50%, -50%) scale(2)';
          ripple.style.opacity = '0';
        }, 10);
      }
    });

    document.addEventListener('mouseup', () => {
      cursor?.classList.remove('click');
    });

    // Ocultar cursor al salir de la ventana
    document.addEventListener('mouseleave', () => {
      cursor?.classList.remove('active');
    });

    document.addEventListener('mouseenter', () => {
      cursor?.classList.add('active');
    });

    // Asegurar que el cursor no afecte la navegación por teclado
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        // Mantener cursor visible pero no interferir
        cursor?.classList.add('active');
      }
    });

    // Cleanup al desmontar
    window.addEventListener('beforeunload', () => {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
      }
    });
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomCursor);
  } else {
    // Pequeño delay para asegurar que el DOM esté completamente listo
    setTimeout(initCustomCursor, 50);
  }

  // También forzar cursor: none en el body inmediatamente
  if (window.innerWidth >= 1024 && window.matchMedia('(pointer: fine)').matches) {
    document.documentElement.style.cursor = 'none';
    document.body.style.cursor = 'none';
  }
</script>
