---
import type { Project } from '../../data/projects';
import Button from './Button.astro';
import SkillBadge from './SkillBadge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-xl overflow-hidden hover:shadow-xl dark:hover:shadow-2xl dark:hover:shadow-primary-900/20 transition-all duration-500 hover:-translate-y-2 hover:scale-[1.02] w-full h-full flex flex-col"
  aria-label={`Proyecto: ${project.title}`}
  style="will-change: transform; opacity: 1; visibility: visible; min-height: 100%;"
>
  {/* Image placeholder - puedes añadir imágenes más tarde */}
  {project.image ? (
    <div class="aspect-video bg-neutral-100 overflow-hidden">
      <img
        src={project.image}
        alt={project.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="aspect-video bg-gradient-to-br from-primary-100 dark:from-primary-900/30 to-accent-50 dark:to-accent-900/30 flex items-center justify-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-200/30 dark:from-primary-800/20 to-accent-200/30 dark:to-accent-800/20"></div>
      <div class="text-primary-500 dark:text-primary-400 text-4xl font-bold opacity-30 dark:opacity-20 relative z-10">
        {project.title.charAt(0)}
      </div>
    </div>
  )}

  <div class="p-6 flex-1 flex flex-col">
    <div class="flex items-start justify-between gap-4 mb-3">
      <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-50 group-hover:bg-gradient-to-r group-hover:from-primary-600 group-hover:to-accent-500 group-hover:bg-clip-text group-hover:text-transparent transition-all duration-300 flex-1">
        {project.title}
      </h3>
      {project.year && (
        <span class="text-sm text-neutral-500 dark:text-neutral-400 font-medium whitespace-nowrap flex-shrink-0">
          {project.year}
        </span>
      )}
    </div>

    <p class="text-neutral-600 dark:text-neutral-300 text-sm md:text-base mb-4 line-clamp-3 flex-1">
      {project.description}
    </p>

    {/* Tags */}
    <div class="flex flex-wrap gap-2 mb-4 min-h-[2.5rem]">
      {project.tags.slice(0, 5).map((tag, index) => (
        <div 
          class="tag-animate"
          style={`animation-delay: ${index * 50}ms;`}
        >
          <SkillBadge name={tag} />
        </div>
      ))}
      {project.tags.length > 5 && (
        <span class="text-xs text-neutral-500 dark:text-neutral-400 self-center">
          +{project.tags.length - 5}
        </span>
      )}
    </div>

    {/* Links */}
    <div class="flex gap-3">
      {project.demoUrl && (
        <Button
          href={project.demoUrl}
          variant="primary"
          size="sm"
          class="flex-1"
        >
          Ver Demo
        </Button>
      )}
      {project.repoUrl && (
        <Button
          href={project.repoUrl}
          variant="outline"
          size="sm"
          class="flex-1"
        >
          Código
        </Button>
      )}
    </div>
  </div>
</article>
