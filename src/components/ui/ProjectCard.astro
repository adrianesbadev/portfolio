---
import type { Project } from '../../data/projects';
import type { Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/translations';
import Button from './Button.astro';

interface Props {
  project: Project;
  locale: Locale;
  index?: number;
}

const { project, locale, index = 0 } = Astro.props as Props;
const t = getTranslations(locale);
const caseNumber = String(index + 1).padStart(2, '0');
const stackSummary = project.tags.slice(0, 4);
---

<article class="panel p-5 md:p-6" data-stagger-item aria-label={`${t.projectCard.caseAria} ${caseNumber}: ${project.title}`}>
  <div class="grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] gap-6 md:gap-8">
    <div>
      {project.image && (
        <div class="rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-800 mb-5">
          <img src={project.image} alt={project.title} class="w-full aspect-video object-cover" loading="lazy" />
        </div>
      )}

      <p class="text-xs uppercase tracking-[0.12em] text-neutral-500 dark:text-neutral-400 mb-2">{t.projectCard.caseLabel} {caseNumber}</p>
      <div class="flex items-start justify-between gap-3 mb-4">
        <h3 class="text-2xl font-semibold tracking-tight text-neutral-950 dark:text-neutral-100">{project.title}</h3>
        {project.year && (
          <span class="text-xs px-2 py-1 rounded-md border border-neutral-200 dark:border-neutral-700 text-neutral-500 dark:text-neutral-400 whitespace-nowrap">
            {project.year}
          </span>
        )}
      </div>

      <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed mb-4">{project.description}</p>

      <dl class="space-y-3 text-sm">
        <div>
          <dt class="text-neutral-500 dark:text-neutral-400">{t.projectCard.problem}</dt>
          <dd class="text-neutral-800 dark:text-neutral-200 mt-1 leading-relaxed">{project.caseStudy.problem}</dd>
        </div>
        <div>
          <dt class="text-neutral-500 dark:text-neutral-400">{t.projectCard.keyDecision}</dt>
          <dd class="text-neutral-800 dark:text-neutral-200 mt-1 leading-relaxed">{project.caseStudy.keyDecision}</dd>
        </div>
        <div>
          <dt class="text-neutral-500 dark:text-neutral-400">{t.projectCard.result}</dt>
          <dd class="text-neutral-800 dark:text-neutral-200 mt-1 leading-relaxed">{project.caseStudy.result}</dd>
        </div>
      </dl>
    </div>

    <div class="space-y-5">
      <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 p-4">
        <p class="text-xs uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400 mb-2">{t.projectCard.roleScope}</p>
        <p class="text-sm text-neutral-800 dark:text-neutral-200 leading-relaxed">{project.caseStudy.role}</p>
      </div>

      <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 p-4">
        <p class="text-xs uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400 mb-2">{t.projectCard.tradeoffs}</p>
        <ul class="case-list space-y-2 text-sm text-neutral-700 dark:text-neutral-300">
          {project.caseStudy.tradeoffs.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 p-4">
        <p class="text-xs uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400 mb-2">{t.projectCard.impact}</p>
        <ul class="case-list space-y-2 text-sm text-neutral-700 dark:text-neutral-300">
          {project.caseStudy.impact.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      {project.caseStudy.nextStep && (
        <div class="rounded-lg border border-primary-200 dark:border-primary-800 bg-primary-50/60 dark:bg-primary-900/20 p-4">
          <p class="text-xs uppercase tracking-[0.08em] text-primary-700 dark:text-primary-300 mb-2">{t.projectCard.nextStep}</p>
          <p class="text-sm text-neutral-800 dark:text-neutral-200 leading-relaxed">{project.caseStudy.nextStep}</p>
        </div>
      )}

      <div>
        <p class="text-xs uppercase tracking-[0.08em] text-neutral-500 dark:text-neutral-400 mb-2">{t.projectCard.secondaryStack}</p>
        <div class="flex flex-wrap gap-2 mb-4">
          {stackSummary.map((tag) => (
            <span class="inline-flex items-center rounded-full border border-neutral-200 dark:border-neutral-700 px-2.5 py-1 text-xs text-neutral-700 dark:text-neutral-300">
              {tag}
            </span>
          ))}
        </div>

        <div class="flex gap-3">
          {project.repoUrl ? (
            <Button href={project.repoUrl} target="_blank" rel="noopener noreferrer" variant="outline" size="sm" class="flex-1">
              {t.projectCard.code}
            </Button>
          ) : (
            <Button href="#contact" variant="outline" size="sm" class="flex-1">
              {t.projectCard.requestAccess}
            </Button>
          )}
          <Button href="#contact" variant="primary" size="sm" class="flex-1">
            {t.projectCard.discussCase}
          </Button>
        </div>
      </div>
    </div>
  </div>
</article>
