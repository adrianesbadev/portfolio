---
// Carrusel de tecnologías con iconos - solo visual, no clickable
interface Props {
  technologies: string[];
}

const { technologies } = Astro.props;

// SVG personalizado para Java
const javaIconPaths = [
  'M47.617 98.12s-4.767 2.774 3.397 3.71c9.892 1.13 14.947.968 25.845-1.092 0 0 2.871 1.795 6.873 3.351-24.439 10.47-55.308-.607-36.115-5.969zm-2.988-13.665s-5.348 3.959 2.823 4.805c10.567 1.091 18.91 1.18 33.354-1.6 0 0 1.993 2.025 5.132 3.131-29.542 8.64-62.446.68-41.309-6.336z',
  'M69.802 61.271c6.025 6.935-1.58 13.17-1.58 13.17s15.289-7.891 8.269-17.777c-6.559-9.215-11.587-13.792 15.635-29.58 0 .001-42.731 10.67-22.324 34.187z',
  'M102.123 108.229s3.529 2.91-3.888 5.159c-14.102 4.272-58.706 5.56-71.094.171-4.451-1.938 3.899-4.625 6.526-5.192 2.739-.593 4.303-.485 4.303-.485-4.953-3.487-32.013 6.85-13.743 9.815 49.821 8.076 90.817-3.637 77.896-9.468zM49.912 70.294s-22.686 5.389-8.033 7.348c6.188.828 18.518.638 30.011-.326 9.39-.789 18.813-2.474 18.813-2.474s-3.308 1.419-5.704 3.053c-23.042 6.061-67.544 3.238-54.731-2.958 10.832-5.239 19.644-4.643 19.644-4.643zm40.697 22.747c23.421-12.167 12.591-23.86 5.032-22.285-1.848.385-2.677.72-2.677.72s.688-1.079 2-1.543c14.953-5.255 26.451 15.503-4.823 23.725 0-.002.359-.327.468-.617z',
  'M76.491 1.587S89.459 14.563 64.188 34.51c-20.266 16.006-4.621 25.13-.007 35.559-11.831-10.673-20.509-20.07-14.688-28.815C58.041 28.42 81.722 22.195 76.491 1.587z',
  'M52.214 126.021c22.476 1.437 57-.8 57.817-11.436 0 0-1.571 4.032-18.577 7.231-19.186 3.612-42.854 3.191-56.887.874 0 .001 2.875 2.381 17.647 3.331z'
].join(' ');

// Mapeo de tecnologías a nombres de exportación de simple-icons
const iconMap: Record<string, string> = {
  'Java': 'CUSTOM_JAVA',
  'Spring Boot': 'siSpring',
  'JavaScript': 'siJavascript',
  'TypeScript': 'siTypescript',
  'React': 'siReact',
  'Astro': 'siAstro',
  'Node.js': 'siNodedotjs',
  'Express': 'siExpress',
  'MySQL': 'siMysql',
  'Tailwind CSS': 'siTailwindcss',
  'Bootstrap': 'siBootstrap',
  'Thymeleaf': 'siThymeleaf',
  'Git': 'siGit',
  'GitHub': 'siGithub',
  'HTML5': 'siHtml5',
  'CSS3': 'siCss3',
  'Python': 'siPython',
  'Docker': 'siDocker',
  'MongoDB': 'siMongodb',
  'PostgreSQL': 'siPostgresql',
};

// Función para obtener el icono y color
async function getIconData(techName: string) {
  const iconExportName = iconMap[techName] || null;
  
  if (techName === 'Java' || iconExportName === 'CUSTOM_JAVA') {
    return {
      path: javaIconPaths,
      color: 'currentColor',
      isJava: true,
    };
  }
  
  if (iconExportName) {
    try {
      const simpleIcons = await import('simple-icons');
      const icon = (simpleIcons as any)[iconExportName];
      
      if (icon && icon.path) {
        return {
          path: icon.path,
          color: icon.hex ? `#${icon.hex}` : '#000000',
          isJava: false,
        };
      }
    } catch (error) {
      if (import.meta.env.DEV) {
        console.warn(`Error loading icon for ${techName}:`, error);
      }
    }
  }
  
  return {
    path: 'M8.5 13.5l5-5M8.5 8.5l5 5M12 3C6.477 3 2 7.477 2 12s4.477 9 10 9 10-4.477 10-9S17.523 3 12 3z',
    color: '#000000',
    isJava: false,
  };
}

// Obtener datos de iconos para todas las tecnologías
const techIcons = await Promise.all(
  technologies.map(async (tech) => ({
    name: tech,
    ...(await getIconData(tech)),
  }))
);

// Duplicar tecnologías para el efecto de carrusel infinito
const duplicatedTechs = [...techIcons, ...techIcons];
---

<div class="tech-carousel-wrapper overflow-hidden py-6">
  <div class="tech-carousel" aria-label="Tecnologías utilizadas en los proyectos">
    <div class="tech-carousel-track">
      {duplicatedTechs.map((tech, index) => (
        <div class="tech-carousel-item" data-tech={tech.name}>
          <div class="flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors duration-200">
            <svg 
              class="flex-shrink-0 w-6 h-6"
              viewBox={tech.isJava ? "0 0 128 128" : "0 0 24 24"}
              fill={tech.isJava ? 'none' : tech.color}
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              style={!tech.isJava ? `color: ${tech.color};` : ''}
            >
              {tech.isJava ? (
                <>
                  <path d="M47.617 98.12s-4.767 2.774 3.397 3.71c9.892 1.13 14.947.968 25.845-1.092 0 0 2.871 1.795 6.873 3.351-24.439 10.47-55.308-.607-36.115-5.969zm-2.988-13.665s-5.348 3.959 2.823 4.805c10.567 1.091 18.91 1.18 33.354-1.6 0 0 1.993 2.025 5.132 3.131-29.542 8.64-62.446.68-41.309-6.336z" fill="#0074BD" />
                  <path d="M69.802 61.271c6.025 6.935-1.58 13.17-1.58 13.17s15.289-7.891 8.269-17.777c-6.559-9.215-11.587-13.792 15.635-29.58 0 .001-42.731 10.67-22.324 34.187z" fill="#EA2D2E" />
                  <path d="M102.123 108.229s3.529 2.91-3.888 5.159c-14.102 4.272-58.706 5.56-71.094.171-4.451-1.938 3.899-4.625 6.526-5.192 2.739-.593 4.303-.485 4.303-.485-4.953-3.487-32.013 6.85-13.743 9.815 49.821 8.076 90.817-3.637 77.896-9.468zM49.912 70.294s-22.686 5.389-8.033 7.348c6.188.828 18.518.638 30.011-.326 9.39-.789 18.813-2.474 18.813-2.474s-3.308 1.419-5.704 3.053c-23.042 6.061-67.544 3.238-54.731-2.958 10.832-5.239 19.644-4.643 19.644-4.643zm40.697 22.747c23.421-12.167 12.591-23.86 5.032-22.285-1.848.385-2.677.72-2.677.72s.688-1.079 2-1.543c14.953-5.255 26.451 15.503-4.823 23.725 0-.002.359-.327.468-.617z" fill="#0074BD" />
                  <path d="M76.491 1.587S89.459 14.563 64.188 34.51c-20.266 16.006-4.621 25.13-.007 35.559-11.831-10.673-20.509-20.07-14.688-28.815C58.041 28.42 81.722 22.195 76.491 1.587z" fill="#EA2D2E" />
                  <path d="M52.214 126.021c22.476 1.437 57-.8 57.817-11.436 0 0-1.571 4.032-18.577 7.231-19.186 3.612-42.854 3.191-56.887.874 0 .001 2.875 2.381 17.647 3.331z" fill="#0074BD" />
                </>
              ) : (
                <path d={tech.path} fill={tech.color} />
              )}
            </svg>
            <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300 whitespace-nowrap">
              {tech.name}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .tech-carousel-wrapper {
    position: relative;
    width: 100%;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 5%,
      black 95%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 5%,
      black 95%,
      transparent 100%
    );
  }

  .tech-carousel {
    width: 100%;
    overflow: hidden;
  }

  .tech-carousel-track {
    display: flex;
    gap: 1rem;
    animation: scroll 30s linear infinite;
    width: fit-content;
  }

  .tech-carousel-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  /* Pausar animación en hover para mejor UX */
  .tech-carousel-wrapper:hover .tech-carousel-track {
    animation-play-state: paused;
  }

  /* Responsive: ajustar velocidad en móviles */
  @media (max-width: 768px) {
    .tech-carousel-track {
      animation-duration: 20s;
    }
  }

  /* Respetar prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .tech-carousel-track {
      animation: none;
      transform: translateX(0);
    }
  }
</style>
